# Copy to .env and edit for your NAS:
#   cp .env.example .env

# --- SSH ---
NAS_HOST=192.168.68.56
NAS_USER=truenas_admin

# --- Pools / paths (adjust to your TrueNAS datasets) ---
CONFIG_POOL=/mnt/WD_Black_1TB_SSD
MEDIA_POOL=/mnt/Skyhawk_8TB_HDD

CONFIG_ROOT=${CONFIG_POOL}/configs
STACKS_ROOT=${CONFIG_POOL}/stacks
DOWNLOADS=${MEDIA_POOL}/Downloads
MEDIA_ROOT=${MEDIA_POOL}/Media

# --- Compose stack remote dirs ---
OBS_REMOTE=${CONFIG_ROOT}/obs-lite
ADGUARD_REMOTE=${CONFIG_ROOT}/adguard-home

# --- Optional ---
# GRAFANA_PASSWORD=change-me
# TAILSCALE_HOSTNAME=truenas-arr
